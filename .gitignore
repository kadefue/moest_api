# --- Data and Large Files ---
# Excludes the entire data directory containing CSVs
data/
!data/csvs/.gitkeep
# Excludes any CSV files if they happen to be in the root
*.csv
*.xls
*.xlsx

# Excludes any generated forecast outputs
Secondary_Subject_Forecast_*.csv

# --- Python Environment & Cache ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.env

# --- Docker & OS ---
# If you use local environment variables for the DB password
.env.docker
.DS_Store
Thumbs.db

# --- Model Artifacts ---
# If you eventually save trained model weights
*.joblib
*.pkl
*.model
